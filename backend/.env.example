# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=your_database_name
DB_PORT=3306

# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Secret
JWT_SECRET=your_super_secret_jwt_key
JWT_EXPIRES_IN=1d
FRONTEND_URL=https://your-shop-domain.com

# Admin account used by `node seedAdmin.js`
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please

# Set to true only once after changing models, then back to false
DB_SYNC_ALTER=false
