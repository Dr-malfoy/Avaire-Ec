# -----------------------------------------------------------------------------
# Backend Environment Variables (.env.example)
# Copy this file to .env and configure for your environment
# -----------------------------------------------------------------------------

# Server Configuration
PORT=5000
NODE_ENV=production

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=aviar_db

# Security & Authentication
JWT_SECRET=generate_a_secure_random_string_here_min_32_characters
JWT_EXPIRES_IN=7d

# Allowed Frontend URLs (comma-separated if multiple domains)
FRONTEND_URL=http://localhost:3000,https://shop.aviar.wearm3s.com,https://aviarbd.com

# Initial Admin Account (Auto-created on first server boot if doesn't exist)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_to_a_strong_password_123

# Database Schema Migration (Set to true only when updating schema, keep false in production)
DB_SYNC_ALTER=false

# Stripe Payment Gateway (Optional - for card payments)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_CURRENCY=bdt
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
